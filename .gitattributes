# Normalise line endings so the repository stays consistent across platforms.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated files are not useful in diffs.
package-lock.json -diff
*.tsbuildinfo -diff
